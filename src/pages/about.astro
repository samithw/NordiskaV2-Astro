---
import { withBase } from '../utils/paths';
import Base from '../layouts/MainLayout.astro';
import PageHero from '../components/main/PageHero.astro';
import CTA from '../components/main/CTA.astro';
import about from '../data/about.json';
---
<Base title="Who we are"><main id="top"><PageHero eyebrow="Who we are" title="We take Nordic cleantech global." copy="Nordiska Solutions is a strategic growth partner dedicated to accelerating the global expansion of Nordic cleantech enterprises. We turn regional innovation into international success." photo="people" action="Explore our expertise" href={withBase('/services/')}/>
<section class="content"><div class="wrap editorial-grid"><div><div class="eyebrow">About Nordiska</div><h2>Unlock the world for your innovation.</h2><div class="rule"></div></div><div class="editorial-copy">{about.intro.map(p=><p>{p}</p>)}</div></div></section>
<section class="content section-soft" id="our-story"><div class="wrap"><div class="section-head"><div class="eyebrow">Our story</div><h2>Every journey starts with a single step.</h2></div><div class="steps"><div class="step"><span>1996</span><h3>Experience across borders.</h3><p>Our founders’ international transaction experience reaches back to 1996, bringing practical knowledge of global markets to every engagement.</p></div><div class="step"><span>2017</span><h3>A bridge to Asia-Pacific.</h3><p>Establishing our first overseas office in Malaysia strengthened our presence in the region and our connection to emerging-market opportunities.</p></div><div class="step"><span>Today</span><h3>Opportunity with purpose.</h3><p>We bring commercial thinking and technical understanding together to help sustainable innovation create lasting value for businesses, people and the planet.</p></div></div></div></section>
<section class="content" id="approach"><div class="wrap editorial-grid"><div><div class="eyebrow">How we work</div><h2>A growth partner.<br/>From strategy to action.</h2></div><div class="editorial-copy"><p>We work alongside your team, connecting strategic thinking with local knowledge, technical understanding and hands-on support. The work starts with your customer, your technology and your growth ambitions.</p><p>Our experience spans cleantech, water, wastewater and process technologies. We connect market insight with practical business development, building the relationships and capabilities needed for international growth.</p><a class="link" href={withBase('/locations/')}>Meet our global network<span>→</span></a></div></div></section>
<section class="content section-soft" id="values"><div class="wrap"><div class="section-head"><div class="eyebrow">Our values</div><h2>Values guide every solution.</h2><p>{about.values}</p></div><div class="steps">{[['Excellence','Quality and commitment in every engagement.'],['Collaboration','Close working relationships with clients and partners.'],['Integrity','Clear principles and responsible business practices.'],['Innovation','Customer-focused thinking for evolving global needs.'],['Inclusivity','Respect for every voice and shared success.']].map(([title,copy],i)=><div class="step"><span>0{i+1}</span><h3>{title}</h3><p>{copy}</p></div>)}</div></div></section><CTA/></main></Base>
