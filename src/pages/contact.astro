---
import { withBase } from '../utils/paths';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import services from '../data/services.json';
import industries from '../data/industries.json';
---
<Base title="Contact"><main id="top"><PageHero eyebrow="Connect with Nordiska" title="Tell us about your next move." copy="Share your technology, your ambition and the opportunity ahead. Let’s explore how we can help you grow." photo="people"/>
<section class="content"><div class="wrap contact-grid"><div><div class="eyebrow">Your next opportunity</div><h2>A conversation with purpose.</h2><div class="rule"></div><p>Help us understand your business, your target market and the kind of support you need. You can change any interests carried forward from another page.</p><a class="link" href={withBase('/locations/')}>Explore our global presence<span>→</span></a></div><form class="contact-form" id="enquiry-form"><div class="form-row"><label>Your name<input name="name" autocomplete="name" required maxlength="200"/></label><label>Company<input name="company" autocomplete="organization" required maxlength="200"/></label></div><label>Work email<input type="email" name="email" autocomplete="email" required maxlength="254"/></label><div class="form-row"><label>Service<select name="service"><option value="">Not sure yet</option>{services.map(s=><option value={s.slug}>{s.name}</option>)}</select></label><label>Industry<select name="industry"><option value="">Select an industry</option>{industries.map(s=><option value={s.slug}>{s.name}</option>)}</select></label></div><div class="form-row"><label>Location<select name="location"><option value="">Not sure yet</option>{['Finland','Malaysia','India','Vietnam','Philippines','UAE'].map(c=><option>{c}</option>)}</select></label><label>Target market<input name="market" maxlength="200" placeholder="Where would you like to grow?"/></label></div><label>Your technology or project<input name="technology" maxlength="300"/></label><label>Your opportunity<textarea name="message" required maxlength="5000"></textarea></label><label class="check-label"><input type="checkbox" name="privacy" required/><span>I have read the <a href={withBase('/privacy/')}>privacy information</a>.</span></label><button class="btn" type="submit">Prepare enquiry<span class="arrow">→</span></button><p class="form-note">Prepare a copy of your enquiry to download. Online submission will be available once Nordiska’s enquiry channel is connected.</p><p id="enquiry-status" class="status" role="status" hidden></p></form></div></section></main><script>import '../scripts/contact.js';</script></Base>
