---
import { withBase } from '../utils/paths';
import Base from '../layouts/Base.astro';
import LocationMap from '../components/LocationMap.astro';
import CTA from '../components/CTA.astro';
const locations=[['Finland','Europe','Nordic expertise, international perspective.','Our Finnish base connects cleantech expertise with international business development and market strategy.'],['Malaysia','Southeast Asia','A bridge to growing markets.','Our first overseas office was established in Malaysia in 2017, strengthening our connection to Asia-Pacific markets and commercial opportunities.'],['India','South Asia','Connect expertise with opportunity.','Discuss market entry, customer development and potential commercial partners for your technology in India.'],['Vietnam','Southeast Asia','Local understanding. Shared ambition.','Explore partner development and opportunities for sustainable technologies in Vietnam.'],['Philippines','Southeast Asia','Relationships that help you grow.','Discuss customer needs, channel opportunities and practical market support for your technology in the Philippines.'],['UAE','Middle East','Your bridge to the region.','Explore opportunities to connect your technology with customers, partners and project stakeholders in the Middle East.']];
---
<Base title="Our global presence"><main id="top"><LocationMap/><section class="content"><div class="wrap"><div class="section-head"><div class="eyebrow">Explore our network</div><h2>Closer to your next opportunity.</h2><p>Tell us where you want to grow. We will discuss the relevant connections and support for your technology, market and commercial priorities.</p></div><div class="location-sections">{locations.map(([name,region,title,copy])=><article class="location-section" id={name.toLowerCase()}><div class="eyebrow">{region} / Nordiska {name}</div><h3>{title}</h3><p>{copy}</p><a class="link" href={withBase(`/contact/?location=${name}`)}>Discuss {name}<span>→</span></a></article>)}</div><div class="section-links"><a class="link" href={withBase('/services/')}>Explore our services<span>↗</span></a><a class="link" href={withBase('/industries/')}>Discover our industries<span>↗</span></a></div></div></section><CTA/></main></Base>
