---
import Base from '../../../layouts/MainHomeLayout.astro';
import MobileHeroCarousel from '../../../components/main/MobileHeroCarousel.astro';
import { mobileHeroSlides } from '../../../data/mobileHeroSlides';
import HomeContent from '../../../components/main/HomeContent.astro';
import { withBase } from '../../../utils/paths';
import BrandPositioning from '../../../components/main/signal-story/Advantage.astro';
import '../../../styles/main/signal-content.css';
---
<Base noindex title="Turning cleantech innovation into international growth">
  <main id="top">
    <h1 class="signal-sr">Nordiska Solutions: turning innovation into international growth</h1>
    <MobileHeroCarousel slides={mobileHeroSlides('focused')}/>
    <orbit-explorer theme="signal" aria-label="Explore Nordiska Solutions"></orbit-explorer>
    <noscript><div class="wrap"><h2>Turning cleantech innovation into international growth.</h2><p>Nordiska Solutions connects Nordic cleantech innovators with international markets, partners and customers.</p><a href={withBase('/services/')}>Explore our services ↗</a></div></noscript>
    <BrandPositioning />
    <HomeContent />
  </main>

  <script is:inline src={withBase('/vendor/signal-orbit/orbit-explorer.js')}></script>
  <script>import '../../../scripts/main/cleantech-home.js';</script>
</Base>
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Manrope:wght@400;500;600;700&display=swap');
.signal-preview{background:#eaf0f7}.signal-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
</style>
