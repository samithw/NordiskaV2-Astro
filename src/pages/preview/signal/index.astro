---
import Base from '../../../layouts/SignalPreviewBase.astro';
import { withBase } from '../../../utils/paths';
import BrandPositioning from '../../../components/BrandPositioning.astro';
import ServicesTeaser from '../../../components/ServicesTeaser.astro';
import WhoWeAreTeaser from '../../../components/WhoWeAreTeaser.astro';
import LocationsTeaser from '../../../components/LocationsTeaser.astro';
---
<Base noindex title="Signal orbit preview">
  <main id="top">
    <h1 class="signal-sr">Nordiska Solutions: turning innovation into international growth</h1>
    <orbit-explorer theme="signal" aria-label="Explore Nordiska Solutions"></orbit-explorer>
    <noscript><div class="wrap"><h2>Your next market. A clear way in.</h2><p>Nordiska Solutions connects Nordic cleantech innovators with international markets, partners and customers.</p><a href={withBase('/services/')}>Explore our services ↗</a></div></noscript>
    <BrandPositioning />
    <ServicesTeaser />
    <WhoWeAreTeaser />
    <LocationsTeaser />
    <section class="cta"><div class="wrap"><div><h2>Your next market starts with a conversation.</h2><p>Share your technology, your ambition and the opportunity ahead. Let’s explore how we can help you grow.</p></div><a class="btn" href={withBase('/contact/')}>Talk to our team ↗</a></div></section>
  </main>
  <nav class="signal-compare" aria-label="Compare hero previews"><span>Signal preview</span><a href={withBase('/preview/hero/')}>Previous preview ↗</a><a href={withBase('/')}>Original homepage ↗</a></nav>
  <script is:inline src={withBase('/vendor/signal-orbit/orbit-explorer.js')}></script>
  <script>import '../../../scripts/signal-preview.js';</script>
</Base>
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Manrope:wght@400;500;600;700&display=swap');
.signal-preview{background:#eaf0f7}.signal-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
.signal-preview .orbit-continuation{display:none}
.signal-compare{position:fixed;right:18px;bottom:18px;z-index:50;display:flex;align-items:center;gap:15px;padding:12px 18px;border:1px solid #bdcee2;border-radius:30px;background:#fbfcfe;box-shadow:0 6px 25px #17346215;font-size:10px;color:#2856a3}.signal-compare span{color:#5d718b}.signal-compare a{font-weight:700}
@media(max-width:600px){.signal-compare{right:10px;bottom:10px;gap:12px;font-size:8px;padding:10px 12px}}
</style>
