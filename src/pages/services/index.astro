---
import Base from '../../layouts/MainLayout.astro';
import PageHero from '../../components/main/PageHero.astro';
import { withBase } from '../../utils/paths';
import services from '../../data/services.json';
import JourneyServiceCard from '../../components/main/JourneyServiceCard.astro';
import '../../styles/main/services-journey.css';
import '../../styles/main/signal-content.css';
const stages = [
 { id:'plan', name:'Find your route', phase:'Market insight & strategy', title:'Start with a clearer direction.', copy:'Before you commit to a new market, understand the opportunity. We help you assess where your technology fits and build a practical plan for taking it there.', outcome:'A clearer market choice and an actionable entry plan.', services:[
  'market-entry-strategy',
  'go-to-market-strategy',
 ]},
 { id:'grow', name:'Build your presence', phase:'Partners, visibility & sales', title:'Put the right relationships in motion.', copy:'A plan becomes useful when people act on it. Find suitable partners, build credibility with buyers and help local channels develop real commercial opportunities.', outcome:'A connected market presence with coordinated commercial activity.', services:[
  'partner-search',
  'market-activation',
  'channel-sales-support',
 ]},
 { id:'support', name:'Support delivery', phase:'Applications, people & continuity', title:'Stay connected beyond the first opportunity.', copy:'Commercial progress needs practical follow-through. Connect your technology with application needs, prepare the people representing it and maintain communication after the sale.', outcome:'Better-prepared teams and continuity across customer relationships.', services:[
  'application-consultancy',
  'on-site-training',
  'aftersales-services',
 ]},
];
---
<Base footerInvitation={{title:'Not sure',accent:'where to start?',copy:'Tell us about your technology, your target market and where you need support. We can explore the right starting point together.',action:'Find your starting point'}} title="What we do">
 <main id="top" class="services-journey-preview">
  <PageHero eyebrow="What we do" title="Expertise for your next stage of growth." copy="We help ambitious companies expand internationally with clarity and confidence. From research-driven market entry strategies to hands-on go-to-market execution, we turn global ambitions into actionable growth plans." photo="sales" action="Explore the journey" href="#journey" />
  <nav class="journey-nav" aria-label="Explore the stages of international growth"><div class="wrap">
   {stages.map((stage,i)=><a href={`#${stage.id}`} data-stage-link={stage.id}><span>0{i+1}</span>{stage.name}<span class="journey-nav-arrow" aria-hidden="true">↘</span></a>)}
  </div></nav>
  <section id="journey" class="journey-intro wrap" aria-labelledby="journey-title">
   <div><div class="eyebrow">A connected approach</div><h2 id="journey-title">One ambition.<br /><span>Support at every stage.</span></h2></div>
   <div><p class="journey-lead">Start where you need us.</p><p>Choose support for one stage or work with us across the journey. This is a typical route: services can overlap, and technical discussions may begin long before market entry.</p><span class="journey-scroll-note">Follow the path to explore our services <span aria-hidden="true">↓</span></span></div>
  </section>
  <div class="journey-route wrap">
   <svg class="journey-path" aria-hidden="true" preserveAspectRatio="none"><path class="journey-path-base"/><path class="journey-path-progress"/></svg>
   {stages.map((stage,i)=><section id={stage.id} class:list={['journey-stage',{'journey-stage-reverse':i===1}]} aria-labelledby={`${stage.id}-title`}>
    <div class="journey-stop" aria-hidden="true"><span>0{i+1}</span></div>
    <div class="journey-stage-intro"><div class="eyebrow">0{i+1} / {stage.name}</div><h2 id={`${stage.id}-title`}>{stage.title}</h2><p>{stage.copy}</p><div class="journey-outcome"><span class="eyebrow">What we work towards</span><p>{stage.outcome}</p></div><span class="journey-phase">{stage.phase}</span></div>
    <div class:list={['journey-service-grid',{'journey-service-grid-three':stage.services.length===3}]}>
     {stage.services.map((slug,j)=>{const service=services.find(s=>s.slug===slug)!;return <JourneyServiceCard {service} number={`0${i+1}.${j+1}`} />})}
    </div>
   </section>)}
   <div class="journey-end"><span aria-hidden="true">↗</span><p>Your next step starts with your priorities.</p></div>
  </div>

  <section class="service-partnership" aria-labelledby="partnership-title">
   <div class="wrap service-partnership-layout">
    <div class="service-partnership-intro"><div class="eyebrow">Working with Nordiska</div><h2 id="partnership-title">Technical understanding.<br/><span>Commercial perspective.</span></h2><p>Taking cleantech into a new market involves more than finding an opportunity. Your technology needs the right application, the right commercial relationships and people who can support it locally.</p><a href={withBase('/industries/')} class="service-partnership-link">Explore our industry expertise <span aria-hidden="true">↗</span></a></div>
    <div class="service-partnership-details">
     <article><span class="service-partnership-number" aria-hidden="true">01</span><div><h3>Support shaped around your priorities.</h3><p>You may need a focused market assessment, help finding a distributor, or technical support for an existing customer. We work with you to define the scope around your technology, target market, available resources and next commercial decision.</p></div></article>
     <article><span class="service-partnership-number" aria-hidden="true">02</span><div><h3>Market knowledge connected to technical context.</h3><p>Our background in cleantech, water, wastewater and process technologies helps connect commercial discussions with application requirements. We bring that understanding to conversations with buyers, EPC contractors, engineering consultants and local partners.</p></div></article>
     <article><span class="service-partnership-number" aria-hidden="true">03</span><div><h3>Practical involvement alongside your team.</h3><p>Advice is a starting point. Our services extend into partner outreach, channel activation, application consultancy, training and aftersales coordination. We work alongside your specialists and local representatives to help turn agreed priorities into practical next steps.</p></div></article>
     <a href={withBase('/locations/')} class="service-partnership-link">Explore our local connections <span aria-hidden="true">↗</span></a>
    </div>
   </div>
  </section>
 </main>

 <script>import '../../scripts/main/services-journey.js';</script>
</Base>

<style>
 .service-partnership{padding:85px 0 90px;background:#eaf0f7;border-top:1px solid #d5e1ed}
 .service-partnership-layout{display:grid;grid-template-columns:1fr 1fr;gap:100px;align-items:start}
 .service-partnership-intro h2{font-size:clamp(34px,3.5vw,51px);line-height:1.12;font-weight:500;letter-spacing:-.055em;margin:25px 0}
 .service-partnership-intro h2 span{color:var(--journey-blue)}
 .service-partnership-intro>p{max-width:430px;font-size:15px;line-height:1.85;color:var(--journey-muted);margin:0 0 30px}
 .service-partnership-details article{display:grid;grid-template-columns:28px 1fr;gap:18px;padding:26px 0;border-top:1px solid #c6d6e6}
 .service-partnership-details article:first-child{padding-top:0;border-top:0}
 .service-partnership-number{font:500 10px/1.6 'IBM Plex Mono',monospace;color:var(--journey-blue);padding-top:5px}
 .service-partnership-details h3{font-size:22px;line-height:1.3;font-weight:500;letter-spacing:-.03em;margin:0 0 12px}
 .service-partnership-details p{font-size:14px;line-height:1.85;color:var(--journey-muted);margin:0}
 .service-partnership-link{display:inline-flex;align-items:center;gap:24px;font-size:12px;font-weight:600;color:var(--journey-blue);padding:10px 0;border-bottom:1px solid #a9bfd7;text-decoration:none}
 .service-partnership-link span{font-size:22px}
 .service-partnership-link:hover{text-decoration:underline;text-underline-offset:4px}
 .service-partnership-details>.service-partnership-link{margin-left:46px;margin-top:4px}
 @media(max-width:1050px){.service-partnership-layout{gap:60px}}
 @media(max-width:760px){.service-partnership{padding:55px 0 60px}.service-partnership-layout{grid-template-columns:1fr;gap:40px}.service-partnership-intro h2{font-size:36px}.service-partnership-details h3{font-size:21px}.service-partnership-intro>p{max-width:none}}
</style>
