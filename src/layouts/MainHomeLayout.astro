---
import { withBase } from '../utils/paths';
import Footer from '../components/main/Footer.astro';
import Header from '../components/main/Header.astro';
import Menu from '../components/main/Menu.astro';
import '../styles/main/approved.css';
import '../styles/main/pages.css';
import '../styles/main/service-cards.css';
const { noindex = false, title = 'Turning innovation into international growth', description = 'Nordiska Solutions connects Nordic cleantech innovators with international markets, partners and customers.' } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} | Nordiska Solutions</title><meta name="description" content={description}/>{noindex && <meta name="robots" content="noindex, nofollow" />}<meta name="theme-color" content="#2856a3"/><link rel="icon" href={withBase('/nordiska-favicon.ico')} type="image/x-icon"/><link rel="preconnect" href="https://images.unsplash.com"/><link rel="preconnect" href="https://fonts.googleapis.com"/></head><body class="signal-preview">
<svg width="0" height="0" aria-hidden="true" style="position:absolute;pointer-events:none"><defs><filter id="brand-blue" color-interpolation-filters="sRGB"><feFlood flood-color="#2856a3"/><feComposite in2="SourceAlpha" operator="in"/></filter></defs></svg>
<a class="skip" href="#top">Skip to content</a><Header/><noscript><nav class="wrap no-script-nav" aria-label="Site navigation"><a href={withBase('/')}>Home</a><a href={withBase('/about/')}>Who we are</a><a href={withBase('/services/')}>What we do</a><a href={withBase('/industries/')}>Industries</a><a href={withBase('/locations/')}>Locations</a><a href={withBase('/contact/')}>Contact</a></nav><style>.hero-track{height:auto!important}.hero{position:relative!important;top:0!important;min-height:650px!important}.hero-images{display:block!important;inset:0!important;width:100%!important;height:100%!important}.hero>.wrap{position:relative!important;width:auto!important;height:auto!important;clip-path:none!important;overflow:visible!important;padding:85px var(--pad)!important}.hero-copy{opacity:1!important;transform:none!important}.hero-deck{display:none!important}.no-script-nav{display:flex;gap:20px;flex-wrap:wrap;padding-top:18px;padding-bottom:18px;font-size:13px}</style></noscript><slot/><Footer/>

<Menu/>
<script>import '../scripts/main/navigation';</script>
</body></html>
