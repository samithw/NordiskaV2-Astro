---
import Header from '../components/main/Header.astro';
import Footer from '../components/main/Footer.astro';
import Menu from '../components/main/Menu.astro';
import { withBase } from '../utils/paths';
import '../styles/main/approved.css';
import '../styles/main/pages.css';
import '../styles/main/service-cards.css';
import '../styles/main/signal-content.css';
import '../styles/concepts.css';
const { title, photography = false, imageOverlay = false } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex, nofollow"/><title>{title} | Nordiska Solutions</title><link rel="icon" href={withBase('/nordiska-favicon.ico')}/><link rel="preconnect" href="https://images.unsplash.com"/><link rel="preconnect" href="https://fonts.googleapis.com"/></head><body class:list={['signal-preview','home-concept',{'hero-preview':photography,'concept-image-overlay':imageOverlay}]} data-image-cover={imageOverlay || undefined}>
<svg width="0" height="0" aria-hidden="true" style="position:absolute;pointer-events:none"><defs><filter id="brand-blue" color-interpolation-filters="sRGB"><feFlood flood-color="#2856a3"/><feComposite in2="SourceAlpha" operator="in"/></filter><filter id="concept-brand" color-interpolation-filters="sRGB"><feFlood style="flood-color:color-mix(in srgb,white,var(--brand) var(--image-header-colour,0%))"/><feComposite in2="SourceAlpha" operator="in"/></filter></defs></svg>
<a class="skip" href="#top">Skip to content</a><Header/><slot/><Footer/><Menu/>
</body></html>
