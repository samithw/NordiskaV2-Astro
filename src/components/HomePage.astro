---
import { withBase } from '../utils/paths';
import LocationsTeaser from '../components/LocationsTeaser.astro';
import Base from '../layouts/Base.astro';
import HeroServices from './HeroServices.astro';
import BrandPositioning from '../components/BrandPositioning.astro';
import ServicesTeaser from '../components/ServicesTeaser.astro';
import ServicesCardsTeaser from '../components/ServicesCardsTeaser.astro';
import PreviewSwitcher from '../components/PreviewSwitcher.astro';
const { servicesVersion = 'a', preview = false } = Astro.props;
---
<Base noindex={preview}>
{preview && <PreviewSwitcher current={servicesVersion} />}
<main id="top">
<div class="hero-track" id="hero-track"><section class="hero" aria-label="International growth">
<div class="hero-images" aria-hidden="true"><img class="active" src="https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=2000&q=88" alt=""></div>
<div class="wrap"><div class="hero-copy"><div class="eyebrow">Nordic expertise. International opportunity.</div><h1 id="hero-headline">Make the next market <span>yours.</span></h1><p id="hero-description">We connect ambitious technology companies with the markets, partners and customers that move their business forward.</p><a href={withBase('/services/')} class="btn">Discover what we do <span class="arrow">→</span></a><div class="hero-note">SCROLL TO EXPLORE YOUR NEXT OPPORTUNITY ↓</div></div></div>
<div class="hero-deck" aria-label="Choose a landscape and explore Nordiska">
<HeroServices />
<div class="deck-story"><div class="eyebrow" id="deck-label">01 / EXPLORE</div><h2 id="deck-title">Make the next market <span>yours.</span></h2><p id="deck-description">We connect ambitious technology companies with the markets, partners and customers that move their business forward.</p><div class="deck-pagination" aria-label="Choose a story"></div></div>
<div class="deck-heading"><span>Nordiska / Featured perspectives</span><span id="deck-count">01 / 04</span></div>
<div class="deck-cards"></div></div>
</section></div>
<BrandPositioning />
{servicesVersion === 'b' ? <ServicesCardsTeaser /> : <ServicesTeaser />}
<section class="content industries" id="industries"><div class="wrap"><div class="industry-intro"><div><div class="eyebrow">Industries we serve</div><h2>Where innovation<br><span>meets its market.</span></h2></div><p>Specialist knowledge. Shared ambition.<br>Explore the sectors where we help technology find its next opportunity.<small>CHOOSE YOUR INDUSTRY ↓</small></p></div><div class="industry-tabs" role="tablist" aria-label="Explore our industries" id="industry-tabs"><button role="tab" id="sector-0" aria-controls="industry-panel" data-sector="0" class="active" aria-selected="true" tabindex="0"><img src="https://images.unsplash.com/photo-1437482078695-73f5ca6c96e2?auto=format&fit=crop&w=1200&q=85" loading="lazy" alt=""><span class="sector-number">01</span><span class="sector-name">Water & wastewater</span><span class="sector-invite" aria-hidden="true">EXPLORE THE POSSIBILITIES <span>↗</span></span></button><button role="tab" id="sector-1" aria-controls="industry-panel" data-sector="1" class="" aria-selected="false" tabindex="-1"><img src="https://images.unsplash.com/photo-1532996122724-e3c354a0b15b?auto=format&fit=crop&w=1200&q=85" loading="lazy" alt=""><span class="sector-number">02</span><span class="sector-name">Solid waste</span><span class="sector-invite" aria-hidden="true">EXPLORE THE POSSIBILITIES <span>↗</span></span></button><button role="tab" id="sector-2" aria-controls="industry-panel" data-sector="2" class="" aria-selected="false" tabindex="-1"><img src="https://images.unsplash.com/photo-1441974231531-c6227db76b6e?auto=format&fit=crop&w=1200&q=85" loading="lazy" alt=""><span class="sector-number">03</span><span class="sector-name">Bioenergy</span><span class="sector-invite" aria-hidden="true">EXPLORE THE POSSIBILITIES <span>↗</span></span></button><button role="tab" id="sector-3" aria-controls="industry-panel" data-sector="3" class="" aria-selected="false" tabindex="-1"><img src="https://images.unsplash.com/photo-1516937941344-00b4e0337589?auto=format&fit=crop&w=1200&q=85" loading="lazy" alt=""><span class="sector-number">04</span><span class="sector-name">Green hydrogen</span><span class="sector-invite" aria-hidden="true">EXPLORE THE POSSIBILITIES <span>↗</span></span></button><button role="tab" id="sector-4" aria-controls="industry-panel" data-sector="4" class="" aria-selected="false" tabindex="-1"><img src="https://images.unsplash.com/photo-1508514177221-188b1cf16e9d?auto=format&fit=crop&w=1200&q=85" loading="lazy" alt=""><span class="sector-number">05</span><span class="sector-name">Solar energy</span><span class="sector-invite" aria-hidden="true">EXPLORE THE POSSIBILITIES <span>↗</span></span></button></div><div class="industry-panel" id="industry-panel" role="tabpanel" tabindex="0"><div class="industry-heading"><span id="industry-number" aria-hidden="true">01</span><div><div class="eyebrow" id="industry-label">Water &amp; wastewater</div><h3 id="industry-title">Making the right connections for better water solutions.</h3></div></div><div class="industry-text"><p id="industry-copy">We help water technology providers connect with end users, EPC contractors and engineering partners. Technical understanding aligns the right technology with real project requirements.</p><div id="industry-specialisms" class="industry-specialisms"></div><a class="link" href={withBase('/industries/water-wastewater/')} id="industry-more">Explore this industry <span class="arrow">↗</span></a></div></div></div></section>
<section class="content" id="about"><div class="wrap about-grid"><div class="about-image"><img src="https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fit=crop&w=1200&q=85" loading="lazy" alt="Professionals collaborating around a meeting table"></div><div><div class="eyebrow">Who we are</div><h2>A growth partner.<br>From strategy to action.</h2><div class="rule"></div><p>Nordiska Solutions helps technology pioneers turn innovation into international commercial impact. Our experience spans international business, cleantech, sales and business development.</p><p>We work alongside your team, connecting strategic thinking with local knowledge, technical understanding and hands-on support.</p><div class="values"><span>Commercial focus</span><span>Technical fluency</span><span>Lasting partnerships</span></div><a class="link" href={withBase('/about/')}>Get to know Nordiska <span class="arrow">→</span></a></div></div></section>
<LocationsTeaser />
<section class="cta" id="contact"><div class="wrap"><div><h2>Your next market starts with a conversation.</h2><p>Share your technology, your ambition and the opportunity ahead. Let’s explore how we can help you grow.</p></div><a class="btn" href={withBase('/contact/')}>Talk to our team <span class="arrow">→</span></a></div></section>
</main>
<script>import '../scripts/home.js';</script>
</Base>
