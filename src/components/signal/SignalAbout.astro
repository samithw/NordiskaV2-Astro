---
import { withBase } from '../../utils/paths';
import SignalLink from './SignalLink.astro';
const strengths = [
 ['Experienced perspective', 'Over 25 years of technical and international business experience.'],
 ['Close collaboration', 'Working alongside your team and the partners representing your technology.'],
 ['Shared purpose', 'Helping sustainable innovation create value for businesses, people and the planet.'],
];
---
<section class="signal-about signal-section" id="about" aria-labelledby="signal-about-title"><div class="wrap">
 <div class="signal-section-intro"><div><div class="eyebrow">Who we are</div><h2 id="signal-about-title">Technical understanding.<br /><span>A commercial mindset.</span></h2></div></div>
 <div class="signal-about-layout">
  <figure class="signal-about-photo"><img class="signal-photo" src="https://images.unsplash.com/photo-1556761175-b413da4baf72?auto=format&fit=crop&w=1200&q=85" alt="Colleagues sharing ideas during a working meeting" loading="lazy" width="1200" height="900" /><figcaption>Understanding the technology. Connecting the people.</figcaption></figure>
  <div class="signal-about-copy"><p class="signal-about-lead">We understand the technology.<br />And the people who move it forward.</p><p>Nordiska Solutions brings together experience in cleantech, water, wastewater and process technologies with practical knowledge of international business.</p><p>We work closely with innovators and their local partners, understanding the technology, the people and the commercial realities behind every opportunity.</p>
   <dl class="signal-strengths">{strengths.map(([title,copy]) => <div><dt>{title}</dt><dd>{copy}</dd></div>)}</dl>
   <SignalLink href={withBase('/about/')} label="Get to know Nordiska" />
  </div>
 </div>
</div></section>
