---
import { withBase } from '../../../utils/paths';
import services from '../../../data/services.json';
import { serviceThemes } from '../../../data/serviceThemes';
import SignalLink from '../signal/SignalLink.astro';
import { servicePhotos } from '../../../data/servicePhotos';
const { refined = false } = Astro.props;
const conciseCopy = ['Assess your market and shape a focused plan for entry and launch.', 'Find the right partners, activate your presence and develop sales opportunities.', 'Support technical applications, prepare local teams and help customers beyond the sale.'];
const themes = refined ? serviceThemes.map((theme, index) => ({...theme, copy:conciseCopy[index], ...(index === 2 ? {photo:servicePhotos['application-consultancy'], alt:'Tools and technical equipment arranged on a workbench'} : {})})) : serviceThemes;
---
<section class:list={["signal-services signal-section", {"services-refined":refined}]} id="services" aria-labelledby="signal-services-title">
 <div class="wrap">
  <div class="signal-section-intro"><div><div class="eyebrow">What we do</div><h2 id="signal-services-title">From your first decision<br /><span>to ongoing support.</span></h2></div><p>{refined ? 'Choose individual services or work with us across your growth journey.' : 'Choose the support you need: market and launch planning, commercial development, or technical services for your local teams and customers.'}</p></div>
  <div class="signal-service-groups">
   {themes.map(theme => <article class="signal-service-group">
    <figure class="signal-service-photo"><img class="signal-photo" src={theme.photo} alt={theme.alt} loading="lazy" width="640" height="480" /></figure>
    <div class="signal-service-copy"><div class="eyebrow">{theme.step}</div><h3>{theme.title}</h3><p>{theme.copy}</p></div>
    <ul class="signal-service-links" aria-label={`${theme.step} services`}>{theme.slugs.map(slug => { const service = services.find(s => s.slug === slug)!; return <li><a href={withBase(`/services/${slug}/`)}><span>{service.name}</span><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" stroke="currentColor" stroke-width="1.2" /></svg></a></li>; })}</ul>
   </article>)}
  </div>
  <div class="signal-services-close"><p>Explore the scope of each service.</p><SignalLink href={withBase('/services/')} label="Explore all services" /></div>
 </div>
</section>

<style>
 :global(.signal-preview) .services-refined .signal-service-group{grid-template-columns:.65fr 1fr 1.2fr;gap:4%}
 :global(.signal-preview) .services-refined .signal-service-copy h3{font-size:clamp(25px,2.1vw,31px)}
 :global(.signal-preview) .services-refined .signal-service-links a{font-size:16px;font-weight:600;min-height:64px;padding:16px 12px;transition:background .2s,color .2s}
 :global(.signal-preview) .services-refined .signal-service-links a:hover{background:#e8f0f9}
 :global(.signal-preview) .services-refined .signal-service-links a:focus-visible{outline:2px solid var(--brand);outline-offset:3px;background:#e8f0f9}
 @media(max-width:1000px){:global(.signal-preview) .services-refined .signal-service-group{grid-template-columns:.65fr 1fr;gap:28px}}
 @media(max-width:700px){:global(.signal-preview) .services-refined .signal-service-group{grid-template-columns:1fr;gap:0}:global(.signal-preview) .services-refined .signal-service-links a{font-size:15px;min-height:60px}}
</style>
