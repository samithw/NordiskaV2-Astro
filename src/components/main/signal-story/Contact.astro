---
import { withBase } from '../../../utils/paths';
import SignalLink from '../signal/SignalLink.astro';
const { title = 'What are you', accent = 'working towards?', copy = 'Tell us about your technology, your target market and the support you need.', action = 'Talk to our team', href = '/contact/' } = Astro.props;
---
<section class="signal-contact signal-section" aria-labelledby="signal-contact-title"><div class="wrap">
 <div class="eyebrow">Let’s move forward</div>
 <h2 id="signal-contact-title">{title}{accent && <>{' '}<br /><span>{accent}</span></>}</h2>
 <div class="signal-contact-bottom"><p>{copy}</p><SignalLink href={withBase(href)} label={action} inverse /></div>
</div></section>
