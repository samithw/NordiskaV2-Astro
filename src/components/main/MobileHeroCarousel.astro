---
import type { MobileHeroSlide } from '../../data/mobileHeroSlides';
interface Props { slides: MobileHeroSlide[]; }
const { slides } = Astro.props;
---
<section class="mobile-hero" aria-label="Explore Nordiska" aria-roledescription="carousel">
 <div class="mobile-hero-track" tabindex="0" aria-label="Swipe or use arrow keys to explore">
  {slides.map((slide, i) => <article class="mobile-hero-slide" aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}`}>
   <img src={slide.image} alt={slide.alt} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} width="1536" height="1024"/>
   <div class="mobile-hero-copy">
    <p class="mobile-hero-label">{slide.label}</p>
    <h2>{slide.headline}</h2>
    <p class="mobile-hero-summary">{slide.copy}</p>
    <a href={slide.url}>{slide.cta}<span aria-hidden="true">↗</span></a>
   </div>
  </article>)}
 </div>
 <div class="mobile-hero-controls">
  <span class="mobile-hero-count" aria-live="polite" aria-atomic="true">01 / {String(slides.length).padStart(2,'0')}</span>
  <span class="mobile-hero-hint">Swipe to explore</span>
  <div><button type="button" data-direction="-1" aria-label="Previous hero slide" disabled>←</button><button type="button" data-direction="1" aria-label="Next hero slide">→</button></div>
 </div>
</section>
<script>
 document.querySelectorAll<HTMLElement>('.mobile-hero').forEach(root => {
  const track = root.querySelector<HTMLElement>('.mobile-hero-track')!;
  const slides = [...root.querySelectorAll<HTMLElement>('.mobile-hero-slide')];
  const count = root.querySelector<HTMLElement>('.mobile-hero-count')!;
  const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-direction]')];
  let currentSlide = 0;
  const index = () => Math.max(0, Math.min(slides.length - 1, Math.round(track.scrollLeft / (track.clientWidth || 1))));
  const update = () => {
   if (!track.clientWidth) return;
   const current = index();
   currentSlide = current;
   count.textContent = `${String(current + 1).padStart(2,'0')} / ${String(slides.length).padStart(2,'0')}`;
   buttons[0].disabled = current === 0;
   buttons[1].disabled = current === slides.length - 1;
   // Keep links in off-screen slides out of the keyboard focus order.
   slides.forEach((slide, i) => { slide.inert = i !== current; });
  };
  const move = (direction: number) => {
   const next = Math.max(0, Math.min(slides.length - 1, index() + direction));
   track.scrollTo({left:next * track.clientWidth,behavior:matchMedia('(prefers-reduced-motion:reduce)').matches?'instant':'smooth'});
  };
  buttons.forEach(button => button.addEventListener('click', () => move(Number(button.dataset.direction))));
  track.addEventListener('scroll', update, {passive:true});
  track.addEventListener('keydown', event => {
   if(event.target !== track || !['ArrowLeft','ArrowRight'].includes(event.key)) return;
   event.preventDefault(); move(event.key === 'ArrowRight' ? 1 : -1);
  });
  // Preserve the selected slide across orientation changes and breakpoint switches.
  let width = track.clientWidth;
  new ResizeObserver(() => {
   const nextWidth = track.clientWidth;
   if(nextWidth && nextWidth !== width) track.scrollTo({left:currentSlide * nextWidth,behavior:'instant'});
   width = nextWidth;
   update();
  }).observe(track);
  update();
 });
</script>
<style>
 .mobile-hero{display:none}
 @media(max-width:760px){
  .mobile-hero{display:block;position:relative;background:#173462;color:white;isolation:isolate}
  .mobile-hero-track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;overscroll-behavior-x:contain}
  .mobile-hero-track::-webkit-scrollbar{display:none}
  .mobile-hero-slide{position:relative;flex:0 0 100%;min-width:0;min-height:650px;height:calc(100svh - 80px);max-height:900px;scroll-snap-align:start;scroll-snap-stop:always;isolation:isolate;display:flex;align-items:end;padding:140px 24px 110px}
  .mobile-hero-slide>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:54% center;z-index:-2}
  .mobile-hero-slide::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,#102a4910 8%,#0b234760 36%,#0b2347ed 80%,#0b2347 100%);z-index:-1;pointer-events:none}
  .mobile-hero-copy{width:100%;max-width:600px}
  .mobile-hero .mobile-hero-label{font:500 9px/1.6 'IBM Plex Mono',monospace;letter-spacing:.08em;text-transform:uppercase;margin:0 0 18px;color:#d8e9fc}
  .mobile-hero h2{font-size:clamp(34px,9.7vw,62px);line-height:1.07;font-weight:500;letter-spacing:-.055em;margin:0;text-wrap:balance}
  .mobile-hero-summary{font-size:14px;line-height:1.65;color:#e0eafa;margin:18px 0 24px;max-width:460px}
  .mobile-hero-copy>a{display:flex;align-items:center;justify-content:space-between;gap:20px;border-top:1px solid #ffffff55;padding-top:18px;font-size:12px;font-weight:600;max-width:360px;color:white}
  .mobile-hero-copy>a span{font-size:22px;font-weight:400}
  .mobile-hero-controls{position:absolute;bottom:22px;left:24px;right:24px;display:flex;align-items:center;justify-content:space-between;gap:12px}
  .mobile-hero-count{font:500 11px 'IBM Plex Mono',monospace}
  .mobile-hero-hint{font-size:9px;color:#c1d3eb}
  .mobile-hero-controls>div{display:flex;gap:8px}
  .mobile-hero-controls button{width:42px;height:42px;display:grid;place-items:center;border:1px solid #b6cce380;border-radius:50%;font-size:20px;color:white;background:#102a4933}
  .mobile-hero-controls button:disabled{opacity:.3}
  .mobile-hero :is(a,button):focus-visible,.mobile-hero-track:focus-visible{outline:2px solid white;outline-offset:4px}
  :global(.mobile-hero~orbit-explorer),:global(.mobile-hero~.hero-track){display:none}
  :global(main:has(.mobile-hero) .orbit-continuation){display:none}
  :global(.home-concept:has(.mobile-hero) .concept-navigation){position:relative;left:auto;bottom:auto;transform:none;margin:24px auto}
  /* Mobile uses the same readable header on every concept; photo overlays stay on desktop. */
  :global(.home-concept.concept-image-overlay:has(.mobile-hero)>header){position:sticky;background:var(--paper);border-color:var(--line);color:var(--brand)}
  :global(.home-concept.concept-image-overlay:has(.mobile-hero)>header::before){display:none}
  :global(.home-concept.concept-image-overlay:has(.mobile-hero):not(.menu-open)>header .brand img){filter:url(#brand-blue)}
  :global(.home-concept.concept-image-overlay:has(.mobile-hero).menu-open>header){background:var(--night);color:white;border-color:#ffffff24}
 }
 @media(max-width:360px){.mobile-hero-slide{padding-left:22px;padding-right:22px;min-height:680px}.mobile-hero h2{font-size:33px}.mobile-hero-summary{font-size:13px}.mobile-hero-controls{left:22px;right:22px}}
</style>
