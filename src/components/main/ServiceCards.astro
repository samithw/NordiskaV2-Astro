---
import JourneyServiceCard from './JourneyServiceCard.astro';
import services from '../../data/services.json';
const { slugs } = Astro.props;
const selected = slugs ? slugs.map((slug: string) => services.find(s => s.slug === slug)).filter(Boolean) : services;
---
<div class="journey-related-grid">{selected.map((service: typeof services[number]) => <JourneyServiceCard {service} />)}</div>
