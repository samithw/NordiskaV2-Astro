---
interface Props { href: string; label: string; inverse?: boolean; }
const { href, label, inverse = false } = Astro.props;
---
<a class:list={['signal-section-link', { 'signal-section-link-inverse': inverse }]} href={href}><span>{label}</span><span class="signal-link-circle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M6 18 18 6M6 6h12v12" stroke="currentColor" stroke-width="1.2" /></svg></span></a>
