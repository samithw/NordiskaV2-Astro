---
import { withBase } from '../../utils/paths';
import GlobalContact from './GlobalContact.astro';
import industries from '../../data/industries.json';
import services from '../../data/services.json';
export interface FooterInvitation {
 title?: string; accent?: string; copy?: string; action?: string; href?: string;
}
interface Props { invitation?: FooterInvitation | false; }
const { invitation = {} } = Astro.props;
const prompt = {
 title:'What are you', accent:'working towards?',
 copy:'Tell us about your technology, your target market and the support you need.',
 action:'Talk to our team', href:'/contact/',
 ...(invitation || {}),
};
const columns = [
 { title:'Expertise', links:services.map(({name,slug}) => [name.replace('ramp-up', 'ramp‑up'), `/services/${slug}/`]) },
 { title:'Industries', links:industries.map(({name,slug}) => [name, `/industries/${slug}/`]) },
 { title:'Nordiska', links:[['Who we are','/about/'],['Our locations','/locations/'],['Contact us','/contact/']] },
];
---
<footer class:list={['site-footer',{'footer-with-invitation':invitation !== false}]}>
 <div class="wrap">
  {invitation !== false && <section class="footer-invitation" aria-labelledby="footer-invitation-title">
   <div><p class="footer-eyebrow">Let’s move forward</p><h2 id="footer-invitation-title">{prompt.title}{prompt.accent && <>{' '}<br/><span>{prompt.accent}</span></>}</h2></div>
   <div class="footer-invitation-action"><p>{prompt.copy}</p><a class="footer-contact-link" href={withBase(prompt.href)}>{prompt.action}<span aria-hidden="true">↗</span></a></div>
  </section>}
  <div class="footer-directory">
   <div class="footer-identity">
    <a class="footer-brand" href={withBase('/')} aria-label="Nordiska Solutions home"><img src={withBase('/nordiska-logo.png')} alt="Nordiska Solutions" width="254" height="134" loading="lazy"/></a>
    <p>We help Nordic cleantech companies enter international markets, build partnerships and support customers locally.</p>
    <GlobalContact variant="footer" showCompany={false} compact/>
   </div>
   {columns.map(({title,links}) => <nav class:list={["footer-navigation", {"footer-expertise":title === "Expertise"}]} aria-label={title}><h2>{title}</h2><ul>{links.map(([name,path]) => <li><a href={withBase(path)}>{name}</a></li>)}</ul></nav>)}
  </div>
  <div class="footer-meta"><span>© {new Date().getFullYear()} Nordiska Solutions</span><a href={withBase('/privacy/')}>Privacy policy</a><a class="footer-top-link" href="#top">Back to top <span aria-hidden="true">↑</span></a></div>
 </div>
</footer>
<style>
 .site-footer{background:var(--night,#173462);color:#f5f8fc;padding:64px 0 24px}
 .footer-invitation{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:80px;align-items:center;padding-bottom:52px}
 .footer-eyebrow{font:500 10px/1.6 'IBM Plex Mono',monospace;text-transform:uppercase;letter-spacing:.1em;color:#b4cce7;margin:0 0 20px}
 .footer-invitation h2{font-size:clamp(40px,4vw,58px);line-height:1.12;letter-spacing:-.045em;font-weight:500;margin:0;text-wrap:balance}
 .footer-invitation h2 span{color:#a8cdec}
 .footer-invitation-action{width:100%;max-width:340px;justify-self:end}
 .footer-invitation-action>p{font-size:14px;line-height:1.8;color:#d2dfef;margin:0 0 22px}
 .footer-contact-link{display:inline-flex;align-items:center;justify-content:space-between;gap:38px;font-size:13px;font-weight:600;background:#e7f1fc;color:#173462;padding:14px 20px;min-height:48px;transition:background .2s}
 .footer-contact-link span{font-size:23px;line-height:1;font-weight:400}
 .footer-contact-link:hover{background:white}
 .footer-directory{display:grid;grid-template-columns:minmax(0,1.8fr) minmax(0,1.85fr) minmax(0,.75fr) max-content;align-items:start;gap:24px;padding:52px 0 56px;border-top:1px solid #cfdef033}
 .site-footer:not(.footer-with-invitation) .footer-directory{border-top:0;padding-top:0}
 .footer-brand{display:block;width:126px}
 .footer-brand img{display:block;width:100%;height:auto;filter:brightness(0) invert(1)}
 .footer-identity{min-width:0}
 .footer-identity>p{font-size:14px;line-height:1.8;color:#bfcfe3;margin:22px 0 26px;max-width:310px}
 .footer-identity :global(.global-contact-label){display:none}
 .footer-identity :global(.global-contact-footer a){font-size:13px;letter-spacing:0;gap:10px;margin-bottom:12px;min-height:24px}
 .footer-identity :global(.global-contact-footer svg){width:15px;height:15px}
 .footer-navigation h2{font:500 11px/1.6 'IBM Plex Mono',monospace;letter-spacing:.08em;text-transform:uppercase;color:#aebfd7;margin:5px 0 24px}
 .footer-navigation ul{list-style:none;padding:0;margin:0;display:grid;gap:16px}
 .footer-expertise{padding-left:48px}
 .footer-expertise ul{grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:repeat(5,auto);grid-auto-flow:column;column-gap:20px}
 .footer-expertise li{align-self:start}
 .footer-expertise a{display:inline-block;max-width:175px;vertical-align:top;text-wrap:pretty}
 .footer-navigation li{font-size:13px;line-height:1.6}
 .footer-navigation a{color:#edf3fc;text-decoration:none;text-underline-offset:5px}
 .footer-navigation a:hover{text-decoration:underline;color:white}
 .footer-meta{display:flex;align-items:center;gap:28px;border-top:1px solid #cfdef033;padding:20px 0;font-size:11px;line-height:1.6;color:#b6c8df}
 .footer-meta>a:hover{color:white}
 .footer-top-link{margin-left:auto;display:inline-flex;align-items:center;gap:12px}
 .footer-top-link span{font-size:16px}
 .site-footer a:focus-visible{outline:2px solid #a8d0ff;outline-offset:6px}
 :global(.home-concept) .site-footer{padding-bottom:92px}
 @media(max-width:1050px){.footer-expertise{padding-left:0}.footer-directory{gap:32px;grid-template-columns:1.3fr 2fr}.footer-navigation:last-child{justify-self:start}.footer-invitation{gap:48px}}
 @media(max-width:760px){
  .site-footer{padding:40px 0 20px}
  :global(.home-concept) .site-footer{padding-bottom:20px}
  .footer-invitation{grid-template-columns:1fr;gap:24px;padding-bottom:36px}
  .footer-invitation h2{font-size:clamp(34px,8.4vw,48px)}
  .footer-eyebrow{margin-bottom:16px}
  .footer-invitation-action{max-width:440px;justify-self:start}
  .footer-directory{grid-template-columns:1fr 1fr;gap:34px 24px;padding:36px 0 40px}
  .footer-identity{grid-column:1/-1}
  .footer-identity>p{max-width:440px;margin:18px 0 22px}
  .footer-expertise{grid-column:1/-1}
  .footer-brand{width:116px}
  .footer-navigation h2{margin:0 0 18px}
  .footer-navigation ul{gap:12px}
  .footer-navigation a{display:inline-block;padding:3px 0}
  .footer-meta{flex-wrap:wrap;gap:12px 20px;padding:18px 0;font-size:10px}
  .footer-meta>span{width:100%}
 }
</style>
