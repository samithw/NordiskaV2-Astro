---
import { withBase } from '../../utils/paths';
import GlobalContact from './GlobalContact.astro';
export interface FooterInvitation {
 title?: string; accent?: string; copy?: string; action?: string; href?: string;
}
interface Props { invitation?: FooterInvitation | false; }
const { invitation = {} } = Astro.props;
const prompt = {
 title:'What are you', accent:'working towards?',
 copy:'Tell us about your technology, your target market and the support you need.',
 action:'Talk to our team', href:'/contact/',
 ...(invitation || {}),
};
const explore = [['Who we are','/about/'],['What we do','/services/'],['Industries','/industries/'],['Locations','/locations/'],['Contact us','/contact/']];
---
<footer class:list={['site-footer',{'footer-with-invitation':invitation !== false}]}>
 <div class="wrap">
  {invitation !== false && <section class="footer-invitation" aria-labelledby="footer-invitation-title">
   <div><p class="footer-eyebrow">Let’s move forward</p><h2 id="footer-invitation-title">{prompt.title}{prompt.accent && <>{' '}<br/><span>{prompt.accent}</span></>}</h2></div>
   <div class="footer-invitation-action"><p>{prompt.copy}</p><a class="footer-contact-link" href={withBase(prompt.href)}>{prompt.action}<span aria-hidden="true">↗</span></a></div>
  </section>}
  <div class="footer-directory">
   <div class="footer-identity"><a class="footer-brand" href={withBase('/')} aria-label="Nordiska Solutions home"><img src={withBase('/nordiska-logo.png')} alt="Nordiska Solutions" width="254" height="134" loading="lazy"/></a><p>Nordic expertise.<br/>International opportunity.</p></div>
   <div class="footer-global"><GlobalContact variant="footer" showCompany={false}/></div>
   <nav class="footer-navigation" aria-labelledby="footer-explore-title"><h2 id="footer-explore-title">Explore Nordiska</h2><ul>{explore.map(([name,path])=><li><a href={withBase(path)}>{name}</a></li>)}</ul></nav>
  </div>
  <div class="footer-meta"><span>© {new Date().getFullYear()} Nordiska Solutions</span><a href={withBase('/privacy/')}>Privacy policy</a><a class="footer-top-link" href="#top">Back to top <span aria-hidden="true">↑</span></a></div>
 </div>
</footer>
<style>
 .site-footer{background:var(--night,#173462);color:#f5f8fc;padding:32px 0 22px}
 .footer-with-invitation{padding-top:48px}
 .footer-invitation{display:grid;grid-template-columns:1.3fr .8fr;gap:12%;align-items:end;padding-bottom:38px}
 .footer-eyebrow{font:500 10px/1.6 'IBM Plex Mono',monospace;text-transform:uppercase;letter-spacing:.08em;color:#b4cce7;margin:0 0 18px}
 .footer-invitation h2{font-size:clamp(40px,4.5vw,64px);line-height:1.07;letter-spacing:-.055em;font-weight:500;margin:0}
 .footer-invitation h2 span{color:#a8cdec}
 .footer-invitation-action>p{font-size:14px;line-height:1.8;color:#d2dfef;max-width:340px;margin:0 0 22px}
 .footer-contact-link{display:inline-flex;align-items:center;justify-content:space-between;gap:34px;font-size:12px;font-weight:600;background:#e7f1fc;color:#173462;padding:13px 18px;min-height:46px;transition:background .2s}
 .footer-contact-link span{font-size:23px;line-height:1;font-weight:400}
 .footer-contact-link:hover{background:white}
 .footer-directory{display:grid;grid-template-columns:.85fr 1.3fr 1fr;align-items:start;gap:40px;padding:30px 0 28px;border-top:1px solid #cfdef033}
 .site-footer:not(.footer-with-invitation) .footer-directory{border-top:0;padding-top:0}
 .footer-brand{display:block;width:110px}
 .footer-brand img{width:100%;height:auto;filter:brightness(0) invert(1)}
 .footer-identity>p{font-size:11px;line-height:1.65;color:#aebfd7;margin:14px 0 0}
 .footer-navigation h2{font:500 9px/1.5 'IBM Plex Mono',monospace;letter-spacing:.07em;text-transform:uppercase;color:#aebfd7;margin:0 0 16px}
 .footer-navigation ul{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:1fr 1fr;gap:12px 24px}
 .footer-navigation li{font-size:12px;line-height:1.5}
 .footer-navigation a{color:#edf3fc;text-decoration:none;text-underline-offset:5px}
 .footer-navigation a:hover{text-decoration:underline}
 .footer-meta{display:flex;align-items:center;gap:28px;border-top:1px solid #cfdef026;padding-top:16px;font-size:10px;line-height:1.6;color:#a8bdd8}
 .footer-meta>a:hover{color:white}
 .footer-top-link{margin-left:auto;display:inline-flex;align-items:center;gap:12px}
 .footer-top-link span{font-size:15px}
 .site-footer a:focus-visible{outline:2px solid #a8d0ff;outline-offset:6px}
 :global(.home-concept) .site-footer{padding-bottom:92px}
 @media(max-width:1050px){.footer-invitation{gap:7%}.footer-directory{grid-template-columns:.7fr 1.3fr 1fr;gap:26px}.footer-navigation ul{gap:12px 16px}}
 @media(max-width:760px){
  .site-footer{padding:28px 0 22px}
  .footer-with-invitation{padding-top:36px}
  :global(.home-concept) .site-footer{padding-bottom:22px}
  .footer-invitation{display:block;padding-bottom:28px}
  .footer-eyebrow{font-size:9px;margin-bottom:16px}
  .footer-invitation h2{font-size:clamp(36px,10vw,54px);max-width:540px}
  .footer-invitation-action{margin-top:22px}
  .footer-invitation-action>p{font-size:13px;line-height:1.75;max-width:420px;margin-bottom:18px}
  .footer-contact-link{padding:11px 16px;min-height:44px}
  .footer-directory{grid-template-columns:1fr 1fr;gap:24px;padding:25px 0}
  .footer-identity{grid-column:1/-1;display:flex;align-items:center;gap:24px}
  .footer-brand{width:88px;flex-shrink:0}
  .footer-identity>p{margin:0;font-size:10px}
  .footer-global{grid-column:1/-1}
  .footer-navigation{grid-column:1/-1}
  .footer-navigation h2{font-size:9px;margin-bottom:12px}
  .footer-navigation ul{display:flex;flex-wrap:wrap;gap:12px 22px}
  .footer-navigation li{font-size:12px}
  .footer-meta{flex-wrap:wrap;gap:10px 24px;font-size:9px;padding-top:15px}
  .footer-meta>span{width:100%}
 }
</style>
