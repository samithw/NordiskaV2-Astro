---
import { mapPlaces as places } from '../../data/locations';
const origin = places[0];
---
<div class="world-network" aria-label="Interactive map of Nordiska locations">
  <div class="world-map-canvas">
    <img src="https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6b/Blank_Map_of_The_World_Equirectangular_Projection.png/1280px-Blank_Map_of_The_World_Equirectangular_Projection.png" width="1280" height="602" alt="World map showing Nordiska's international locations" />
    <svg class="world-routes" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      {places.slice(1).map(place => <path d={`M${origin.x},${origin.y} Q${(origin.x + place.x) / 2},${origin.y} ${place.x},${place.y}`} />)}
    </svg>
    {places.map(place => <button class="map-pin" style={`left:${place.x}%;top:${place.y}%`} data-country={place.name} aria-label={`Nordiska ${place.name}`} aria-pressed="false"><span>{place.name}</span></button>)}
    <small class="map-caption">Map: FelixCountryBalls163 / Wikimedia Commons · CC BY 4.0</small>
  </div>
</div>
<p class="map-scroll-hint">Swipe to explore the map <span aria-hidden="true">↔</span></p>
<style>
  .world-network { overflow-x:auto; overflow-y:hidden; }
  .world-map-canvas { position:relative; width:100%; aspect-ratio:1280 / 602; }
  .world-map-canvas > img { display:block; width:100%; height:100%; object-fit:contain; filter:grayscale(1); opacity:.43; }
  .world-map-canvas::after { content:""; position:absolute; inset:0; background:#b4c9eb26; pointer-events:none; }
  .world-network::after { display:none; }
  .map-scroll-hint { display:none; }
  .map-pin span { pointer-events:none; }
  @media(max-width:760px) {
    .world-map-canvas { min-width:760px; }
    .map-scroll-hint { display:flex; justify-content:space-between; font-size:11px; color:var(--muted); margin:10px 0 0; }
    .map-pin { width:22px; height:22px; }
    .map-pin::after { inset:7px; }
    .map-pin span { font-size:11px; }
    .map-caption { font-size:9px; left:12px; bottom:10px; }
  }
</style>
<script>
  document.querySelectorAll<HTMLElement>('.world-network').forEach(map => {
    const breakpoint = matchMedia('(max-width:760px)');
    const focusRegion = () => { map.scrollLeft = breakpoint.matches ? Math.max(0, map.scrollWidth - map.clientWidth - 32) : 0; };
    focusRegion();
    breakpoint.addEventListener('change', focusRegion);
  });
</script>
