---
import { withBase } from '../../utils/classicPaths';
const { title = 'Your next market starts with a conversation.', copy = 'Share your technology, your ambition and the opportunity ahead. Let’s explore how we can help you grow.', href = '/contact/', action = 'Talk to our team' } = Astro.props;
---
<section class="cta"><div class="wrap"><div><h2>{title}</h2><p>{copy}</p></div><a class="btn" href={withBase(href)}>{action}<span class="arrow">→</span></a></div></section>
