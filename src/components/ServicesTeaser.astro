---
import { withBase } from '../utils/paths';
import services from '../data/services.json';
import photos from '../data/photos.json';
const themes = [
  { title: 'Enter the right market.', label: 'Clarity before the first move', copy: 'Know where your technology belongs. Turn market insight into a focused entry plan, with the positioning and channels to give it a strong start.', photo: photos.coast, alt: 'Open coastline stretching toward the horizon', slugs: ['market-entry-strategy', 'go-to-market-strategy'] },
  { title: 'Build commercial momentum.', label: 'Connections that move you forward', copy: 'Get closer to the people who matter. Develop the right partnerships, activate your market presence and turn promising conversations into sales opportunities.', photo: photos.people, alt: 'People collaborating around a shared table', slugs: ['partner-search', 'channel-sales-support', 'market-activation'] },
  { title: 'Make growth work on the ground.', label: 'Expertise that stays alongside you', copy: 'Give your technology the support it needs in the real world. Help local teams understand its application, build confidence and support customers beyond the first sale.', photo: photos.wind, alt: 'Energy infrastructure across an open landscape', slugs: ['application-consultancy', 'on-site-training', 'aftersales-services'] },
];
---
<section class="services-teaser" id="services" aria-labelledby="services-title">
  <div class="wrap">
    <div class="services-intro">
      <div>
        <div class="eyebrow">What we do</div>
        <h2 id="services-title">Your ambition.<br /><span>Our expertise in motion.</span></h2>
      </div>
      <p>Every next step needs the right support. From finding your market to making it work, explore how we help your technology go further.</p>
    </div>
    <div class="services-editorial">
      <div class="service-perspective" aria-hidden="true">
        <div class="perspective-images">
          {themes.map((theme, i) => <img src={theme.photo} alt="" loading="lazy" class:list={{ active: i === 0 }} data-perspective={i} />)}
        </div>
        <div class="perspective-caption">
          <span class="perspective-count">01 / 03</span>
          <p class="perspective-label">{themes[0].label}</p>
          <span class="perspective-arrow">↗</span>
        </div>
      </div>
      <div class="service-chapters">
        {themes.map((theme, i) => (
          <article class:list={['service-chapter', { active: i === 0 }]} data-chapter={i}>
            <div class="chapter-heading">
              <span class="chapter-number" aria-hidden="true">0{i + 1}</span>
              <h3><button type="button" data-theme={i} data-caption={theme.label} aria-pressed={i === 0}>{theme.title}<span aria-hidden="true">↗</span></button></h3>
            </div>
            <div class="chapter-body">
              <p>{theme.copy}</p>
              <ul aria-label={`Services to ${theme.title.toLowerCase().replace(/\.$/, '')}`}>
                {theme.slugs.map(slug => { const service = services.find(s => s.slug === slug)!; return <li><a href={withBase(`/services/${slug}/`)}>{service.name}<span aria-hidden="true">↗</span></a></li>; })}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
    <div class="services-footer">
      <p>A clear way in. A partner for what comes next.</p>
      <a href={withBase('/services/')} class="all-services">Explore all services <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .services-teaser { padding:90px 0 100px; background:var(--paper); scroll-margin-top:130px; }
  .services-intro { display:grid; grid-template-columns:1.4fr 1fr; align-items:end; gap:10%; margin-bottom:60px; }
  .services-intro .eyebrow { color:var(--brand); margin-bottom:25px; }
  .services-intro h2 { font-size:clamp(36px,4.1vw,60px); line-height:1.1; margin:0; letter-spacing:-.05em; }
  .services-intro h2 span { color:var(--brand); }
  .services-intro > p { font-size:16px; line-height:1.85; color:var(--muted); margin:0 0 4px; max-width:380px; }
  .services-editorial { display:grid; grid-template-columns:.85fr 1.35fr; gap:8%; align-items:start; }
  .service-perspective { position:sticky; top:148px; height:clamp(440px,47vw,620px); overflow:hidden; border-radius:0 80px 0 0; background:var(--night); }
  .perspective-images { position:absolute; inset:0; }
  .perspective-images::after { content:""; position:absolute; inset:0; background:linear-gradient(180deg,#17346205 30%,#173462d9); }
  .perspective-images img { position:absolute; inset:0; height:100%; width:100%; object-fit:cover; opacity:0; transition:opacity .45s ease; filter:saturate(.7); }
  .perspective-images img.active { opacity:1; }
  .perspective-caption { position:absolute; left:30px; right:30px; bottom:34px; color:white; }
  .perspective-count { display:block; font-size:11px; font-weight:700; letter-spacing:.15em; margin-bottom:24px; }
  .perspective-label { font-size:clamp(24px,2.7vw,38px); line-height:1.18; letter-spacing:-.04em; font-weight:500; margin:0; max-width:85%; }
  .perspective-arrow { display:block; font-size:28px; margin-top:24px; color:var(--accent); }
  .service-chapter { border-top:1px solid var(--line); padding:30px 0 32px; }
  .service-chapter:first-child { padding-top:24px; }
  .chapter-heading { display:grid; grid-template-columns:42px 1fr; gap:14px; align-items:start; }
  .chapter-number { font-size:11px; font-weight:800; letter-spacing:.06em; padding-top:10px; color:var(--muted); transition:color .2s; }
  .chapter-heading h3 { margin:0; font-size:clamp(23px,2.5vw,35px); line-height:1.15; letter-spacing:-.045em; }
  .chapter-heading button { display:flex; align-items:start; justify-content:space-between; gap:18px; width:100%; padding:0; border:0; background:none; color:var(--ink); font:inherit; letter-spacing:inherit; line-height:inherit; text-align:left; cursor:pointer; transition:color .2s; }
  .chapter-heading button > span { color:var(--brand); font-size:22px; font-weight:400; padding-top:3px; transition:transform .2s; }
  .service-chapter.active .chapter-number,.service-chapter.active button { color:var(--brand); }
  .chapter-heading button:hover > span { transform:translate(3px,-3px); }
  .chapter-body { padding-left:56px; }
  .chapter-body > p { font-size:14px; color:var(--muted); line-height:1.8; margin:17px 0 18px; max-width:490px; }
  .chapter-body ul { list-style:none; display:flex; flex-wrap:wrap; column-gap:22px; row-gap:10px; padding:0; margin:0; }
  .chapter-body li { margin:0; }
  .chapter-body a { display:inline-flex; gap:8px; align-items:center; font-size:11px; font-weight:700; color:var(--ink); text-decoration:none; text-decoration-thickness:1px; text-underline-offset:5px; }
  .chapter-body a > span { color:var(--brand); font-size:14px; }
  .chapter-body a:hover { color:var(--brand); text-decoration:underline; }
  .services-teaser a:focus-visible,.chapter-heading button:focus-visible { outline:2px solid var(--brand); outline-offset:6px; }
  .services-footer { display:flex; align-items:center; justify-content:space-between; gap:24px; border-top:1px solid var(--line); padding-top:30px; margin-top:36px; }
  .services-footer p { margin:0; font-size:14px; color:var(--muted); }
  .all-services { display:flex; align-items:center; gap:38px; color:var(--brand); font-size:14px; font-weight:800; text-decoration:none; }
  .all-services span { display:grid; place-items:center; width:45px; height:45px; border:1px solid #adc8e0; border-radius:50%; font-size:22px; transition:background .2s,color .2s; }
  .all-services:hover span { background:var(--brand); color:white; }
  @media(max-width:900px) {
    .services-editorial { grid-template-columns:.75fr 1.25fr; gap:5%; }
    .chapter-heading { grid-template-columns:28px 1fr; gap:10px; }
    .chapter-body { padding-left:38px; }
    .perspective-caption { left:24px; right:24px; }
  }
  @media(max-width:640px) {
    .services-teaser { padding:60px 0; scroll-margin-top:95px; }
    .services-intro { display:block; margin-bottom:32px; }
    .services-intro > p { font-size:15px; margin-top:22px; }
    .services-intro .eyebrow { margin-bottom:20px; }
    .services-editorial { display:block; }
    .service-perspective { position:relative; top:auto; height:270px; margin-bottom:35px; border-radius:0 60px 0 0; }
    .perspective-caption { bottom:24px; }
    .perspective-count { margin-bottom:15px; }
    .perspective-label { font-size:27px; max-width:75%; }
    .perspective-arrow { position:absolute; right:0; bottom:0; margin:0; }
    .chapter-heading h3 { font-size:27px; }
    .chapter-body a { font-size:12px; }
    .chapter-body ul { display:block; }
    .chapter-body li + li { margin-top:12px; }
    .services-footer { align-items:start; flex-direction:column; margin-top:6px; gap:20px; }
    .all-services { justify-content:space-between; width:100%; }
  }
  @media(prefers-reduced-motion:reduce) { .services-teaser * { transition:none!important; } }
</style>

<script>
  const section = document.querySelector<HTMLElement>('.services-teaser');
  if (section) {
    const chapters = Array.from(section.querySelectorAll<HTMLElement>('[data-chapter]'));
    const buttons = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-theme]'));
    const images = Array.from(section.querySelectorAll<HTMLImageElement>('[data-perspective]'));
    const caption = section.querySelector<HTMLElement>('.perspective-label');
    const count = section.querySelector<HTMLElement>('.perspective-count');
    function selectTheme(index: number) {
      chapters.forEach((chapter, i) => chapter.classList.toggle('active', i === index));
      buttons.forEach((button, i) => button.setAttribute('aria-pressed', String(i === index)));
      images.forEach((image, i) => image.classList.toggle('active', i === index));
      if (caption) caption.textContent = buttons[index].dataset.caption ?? '';
      if (count) count.textContent = `0${index + 1} / 03`;
    }
    chapters.forEach((chapter, index) => {
      chapter.addEventListener('pointerenter', event => { if (event.pointerType === 'mouse') selectTheme(index); });
      chapter.addEventListener('focusin', () => selectTheme(index));
      buttons[index].addEventListener('click', () => selectTheme(index));
    });
  }
</script>
